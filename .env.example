# ---- WildCard: copy this file to .env ----
#   cp .env.example .env
# .env is gitignored and never committed.

# ---------- DB ----------
DB_NAME=wildcard
DB_USER=wildcard
# Do not leave this empty. Provide a value for docker-compose.
DB_PASSWORD=

# ---------- Security ----------
# JWT key. MINIMUM 32 characters. When empty the app generates a development
# key and logs a WARNING (not acceptable for production).
JWT_SECRET=

# ---------- Admin (first seed only) ----------
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@wildcard.com
ADMIN_PASSWORD=CHANGE_ME_at_least_8_chars

# ---------- Demo users (seed) ----------
# when set to true, demo accounts are created in the feed; their password:
SEED_ENABLED=true
SEED_USER_PASSWORD=demo123456

# ---------- External APIs ----------
# TMDB (movie search). When empty FILM search is TURNED OFF and
# manual title entry still works. The key is never written to logs or responses.
TMDB_API_KEY=

# AniList and iTunes need no key.

# ---------- E-mail (forgot password) ----------
# When MAIL_HOST is empty the reset link is printed to the console while the UI
# still says "link sent".
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Forgot-password link target: {FRONTEND_URL}/#reset/{token}
FRONTEND_URL=http://localhost:5173
