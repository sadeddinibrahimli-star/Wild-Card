# ---- WildCard: kopyalayıb .env yaradın ----
#   cp .env.example .env
# .env gitignore-dadır, repoya düşmür.

# ---------- DB ----------
DB_NAME=wildcard
DB_USER=wildcard
# Boş buraxmayın. docker-compose üçün dəyər verin.
DB_PASSWORD=

# ---------- Təhlükəsizlik ----------
# JWT açarı. MİNİMUM 32 simvol. Boşdursa app development açarı yaradır
# və LOGDA XƏBƏRDARLIQ YAZIR (production üçün qəbul edilmir).
JWT_SECRET=

# ---------- Admin (yalnız ilk dəfə seed üçün) ----------
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@wildcard.com
ADMIN_PASSWORD=CHANGE_ME_at_least_8_chars

# ---------- Demo istifadəçilər (seed) ----------
# true edilsə feed-də demo hesablar yaradılır; onların şifrəsi:
SEED_ENABLED=true
SEED_USER_PASSWORD=demo123456

# ---------- Xarici API-lər ----------
# TMDB (film axtarışı). Boşdursa FILM axtarışı SÖNDÜRÜLÜR,
# əl ilə başlıq yazmaq işləyir. Açar loga və cavaba YAZILMIR.
TMDB_API_KEY=

# AniList və iTunes açar tələb etmir.

# ---------- E-poçt (forgot password) ----------
# MAIL_HOST boşdursa reset linki KONSOLA yazılır və UI
# "link göndərildi" deyir.
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Forgot-password linkinin yonlendirmesi: {FRONTEND_URL}/#reset/{token}
FRONTEND_URL=http://localhost:5173
